APP_URL=http://localhost:3000
LARAVEL_API_URL=http://127.0.0.1:8000
LARAVEL_SESSION_COOKIE=nv_session
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_COOKIE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8000
# Shared with Laravel BFF_RATE_SECRET; a separate 32-byte random hex key.
BFF_RATE_SECRET=
# Set only when your ingress overwrites it. Nginx example: x-real-ip.
TRUSTED_CLIENT_IP_HEADER=
