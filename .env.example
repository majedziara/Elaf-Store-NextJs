APP_URL=http://localhost:3000
LARAVEL_API_URL=http://127.0.0.1:8000
LARAVEL_SESSION_COOKIE=nv_session
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_COOKIE_KEY=REPLACE_WITH_64_HEX_CHARACTERS
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8000
# Shared with Laravel BFF_RATE_SECRET; a separate 32-byte random hex key.
BFF_RATE_SECRET=
# Set only when your ingress overwrites it. Nginx example: x-real-ip.
TRUSTED_CLIENT_IP_HEADER=

# Public canonical origin; keep this as the production storefront even during local previews.
NEXT_PUBLIC_SITE_URL=https://elaf-store.vercel.app
NEXT_PUBLIC_GA_ID=G-KXMX3VBRZ7
# Analytics only runs on the production hostname; local/preview traffic is excluded.
# Vercel production must also set APP_URL=https://elaf-store.vercel.app
# Vercel production origins (set these three in its Environment Variables):
# APP_URL=https://elaf-store.vercel.app
# LARAVEL_API_URL=https://elaf-store.onrender.com
# NEXT_PUBLIC_MEDIA_URL=https://elaf-store.onrender.com
